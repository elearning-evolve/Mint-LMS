# Development and CI (not shipped)
/.git
/.gitignore
/.github
/.githooks
/.distignore
/.phpunit.cache
/.wp-qa
/phpcs.xml
/phpstan.neon
/phpunit.xml.dist
# Keep composer.json + lock in any .distignore-based package (staging download,
# wp.org Git deploy). Plugin Check requires them when /vendor is present.
/package.json
/package-lock.json
/tailwind.config.js
/postcss.config.js
/dev
/wp-qa-check.sh
/README.md
/readme.md

# Source assets (built files in assets/dist are included)
/assets/src
/node_modules

# Tests
/tests

# Working-tree vendor is replaced by `composer install --no-dev` in the release build.
# Do not ship a partial/dev vendor via .distignore surgery.
/vendor

# Local build output
/dist
